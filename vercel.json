{
  "version": 2,
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node" },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api(?:/(.*))?$", "dest": "/api/[...path].ts" },
    { "src": "^(?!/api/).*$", "dest": "/index.html" }
  ]
}
