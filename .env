## Root env example
## Copy to .env at repo root (optional) or set env vars in Vercel.

# PostgreSQL connection string
# Example: postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DATABASE_URL="postgresql://postgres:root@localhost:5432/estudio_contable?schema=public"

# JWT secret (change in production)
JWT_SECRET="0bfa689361ad090220f313e06b53df8bdac32fa788a76e78712ac2cd9068a556"

# CORS
CLIENT_ORIGIN="http://localhost:5173"
