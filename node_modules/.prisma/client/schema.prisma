// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payrollHistory PayrollHistory[]
}

model Client {
  id        String   @id @default(uuid())
  name      String
  rfc       String   @unique
  regimen   String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recurringInvoices RecurringInvoice[]
  declarations      Declaration[]
}

enum RecurrenceFrequency {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  YEARLY
}

enum InvoicePaymentStatus {
  PENDING
  PAID
  OVERDUE
}

model RecurringInvoice {
  id             String               @id @default(uuid())
  clientId       String
  client         Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  concept        String
  amount         Decimal              @db.Decimal(12, 2)
  /// Saldo pendiente de cobro (debe coincidir con el pago conciliado)
  pendingBalance Decimal              @db.Decimal(12, 2)
  paymentStatus  InvoicePaymentStatus @default(PENDING)
  currency       String               @default("MXN")
  frequency      RecurrenceFrequency  @default(MONTHLY)
  startDate      DateTime
  nextRunDate    DateTime
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  /// Conciliación que marcó esta factura como PAGADA (si aplica).
  markedPaidByMatch BankReconciliationMatch? @relation("RecurringInvoiceMarkedByMatch")

  @@index([clientId])
  @@index([active, nextRunDate])
  @@index([paymentStatus])
}

model PayrollHistory {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeName   String
  fiscalYear     Int       @default(2026)
  grossMonthly   Decimal   @db.Decimal(14, 2)
  grossPeriod    Decimal   @db.Decimal(14, 2)
  imssTotal      Decimal   @db.Decimal(14, 2)
  subsidyApplied Decimal   @db.Decimal(14, 2)
  netEstimate    Decimal   @db.Decimal(14, 2)
  payDate        DateTime?
  calculatedAt   DateTime  @default(now())

  @@index([userId, fiscalYear])
  @@index([calculatedAt])
}

enum BankEntryType {
  CREDIT
  DEBIT
}

enum BankEntrySource {
  BOOK // movimiento interno (contabilidad)
  BANK // estado de cuenta
}

model BankMovement {
  id          String          @id @default(uuid())
  date        DateTime
  description String
  reference   String?
  amount      Decimal         @db.Decimal(14, 2) // + ingreso, - egreso
  type        BankEntryType
  source      BankEntrySource @default(BOOK)
  category    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  match BankReconciliationMatch?

  @@index([date])
}

model BankStatementLine {
  id          String          @id @default(uuid())
  date        DateTime
  description String
  reference   String?
  amount      Decimal         @db.Decimal(14, 2)
  type        BankEntryType
  source      BankEntrySource @default(BANK)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  match BankReconciliationMatch?

  @@index([date])
}

model BankReconciliationMatch {
  id                       String   @id @default(uuid())
  movementId               String   @unique
  statementLineId          String   @unique
  /// Si la conciliación marcó una factura recurrente como PAGADA, se guarda para revertir al desconciliar.
  markedRecurringInvoiceId String?  @unique
  createdAt                DateTime @default(now())

  movement               BankMovement      @relation(fields: [movementId], references: [id], onDelete: Cascade)
  statementLine          BankStatementLine @relation(fields: [statementLineId], references: [id], onDelete: Cascade)
  markedRecurringInvoice RecurringInvoice? @relation("RecurringInvoiceMarkedByMatch", fields: [markedRecurringInvoiceId], references: [id], onDelete: SetNull)
}

enum DeclarationType {
  PROVISIONAL
  ANNUAL
  PAYROLL
  VAT
}

enum DeclarationStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  PAID
  OVERDUE
}

model Declaration {
  id        String            @id @default(uuid())
  clientId  String
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      DeclarationType   @default(PROVISIONAL)
  status    DeclarationStatus @default(PENDING)
  // Periodo en formato YYYY-MM (para provisionales mensuales)
  period    String
  dueDate   DateTime
  filedAt   DateTime?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([clientId, type, period])
  @@index([clientId])
  @@index([status, dueDate])
}
