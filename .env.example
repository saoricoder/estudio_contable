## Root env example
## Copy to .env at repo root (optional) or set env vars in Vercel.

# PostgreSQL connection string
# Example: postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/estudio_contable?schema=public"

# JWT secret (change in production)
JWT_SECRET="change-me"

# CORS
CLIENT_ORIGIN="http://localhost:5173"
